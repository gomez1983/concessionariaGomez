# Modelo de credenciais locais do docker-compose.yml.
# Copie para .env e troque os valores:   copy .env.example .env   (PowerShell: Copy-Item .env.example .env)
# O arquivo .env NÃO é versionado (.gitignore).

# Senha do root do MySQL. Usada apenas para administração e pelo healthcheck.
# Atenção: o MySQL só aplica esta senha quando o volume do banco é criado pela primeira vez.
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Usuário da aplicação (backend), com permissões apenas no schema "concessionaria".
# Em um volume novo, o MySQL cria este usuário automaticamente.
# Em um volume já existente, crie-o manualmente (veja docs/GUIA_DEVOPS_E_DOCKER.md).
DB_APP_USERNAME=concessionaria_app
DB_APP_PASSWORD=troque-esta-senha-da-aplicacao

# Chave de assinatura dos tokens de acesso (HS256). Obrigatória: sem ela o backend não sobe.
# Base64 com pelo menos 32 bytes (256 bits). Gere uma chave aleatória com:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Bash:       openssl rand -base64 48
# Trocar a chave desconecta todos os usuários (os tokens já emitidos deixam de valer).
JWT_SECRET=

# Senhas dos usuários iniciais do painel (10 a 72 caracteres). Os usuários são criados na primeira
# subida em que não existirem; mudar a senha aqui depois NÃO altera um usuário que já existe.
#   admin@concessionariagomez.com.br     (ADMIN)
#   gerente@concessionariagomez.com.br   (GERENTE)
#   vendedor@concessionariagomez.com.br  (VENDEDOR)
# Deixe vazio para não criar o usuário.
SEED_ADMIN_PASSWORD=
SEED_GERENTE_PASSWORD=
SEED_VENDEDOR_PASSWORD=

# Opcional. Perfil da API: prod (padrão) desliga o Swagger/OpenAPI e as mensagens internas de erro;
# dev liga o Swagger e o SQL no log. Use dev apenas na sua máquina.
# SPRING_PROFILES_ACTIVE=dev

# Opcional. Senha do root do MySQL usada pelos testes de integração (mvnw verify).
# Sem ela, os testes usam MYSQL_ROOT_PASSWORD.
# TEST_DB_PASSWORD=

# Opcional. O cookie de sessão é Secure por padrão. Sem HTTPS, os navegadores só o aceitam em
# localhost/127.0.0.1; para acessar pelo IP da rede local sem HTTPS, defina false.
# AUTH_COOKIE_SECURE=true
