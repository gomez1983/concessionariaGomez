            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/carros",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["carros"]
            },
            "description": "Retorna os veículos cadastrados no banco com paginação default (page=0, size=10), quilometragem, flag zeroKm e links HATEOAS."
          },
          "response": []
        },
        {
          "name": "1.1 Filtrar Carros por Ano",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/carros?ano=2007",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["carros"],
              "query": [
                {
                  "key": "ano",
                  "value": "2007",
                  "description": "Filtro opcional pelo ano de fabricação"
